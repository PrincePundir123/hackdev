# Node 24. Copy to .env; secrets stay on the server.
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=./data/saathi.sqlite
APP_URL=http://localhost:3001
# Synthetic demo accounts are enabled locally; explicitly opt in for production demos.
DEMO_MODE=true
# Optional OpenAI-compatible chat-completions provider. Set all three for live AI.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
# Optional outbound webhook; notifications contain identifiers only, not private notes.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=
# Keep false locally; enable behind HTTPS.
COOKIE_SECURE=false
